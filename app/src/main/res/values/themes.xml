<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.StockSample" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="upColor">@color/up_color</item>
        <item name="downColor">@color/down_color</item>
        <item name="textColorPrimary">?android:textColorPrimary</item>
    </style>

    <style name="Theme.StockSample" parent="Base.Theme.StockSample" />

    <!-- BaseCenterDialog 使用的主題：背景透明由內容自行繪製圓角，取消最小寬度讓寬度依內容而定 -->
    <style name="ThemeOverlay.StockSample.CenterDialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">50%</item>
        <item name="android:windowMinWidthMinor">80%</item>
    </style>

</resources>
